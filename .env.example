# Copy to .env and fill in. .env is gitignored

# Which machine this is.
#   show : the computer wired to the cube. Kiosk window, no devtools, and the
#          real MIDI controllers (LaunchControl, MidiFighter) are opened.
#   dev  : anything else. Normal window, on-screen MIDI emulator.
# Left out entirely it means dev, so a machine with no .env can only ever end up
# in the harmless one. Override for a single run with:  L3D_PROFILE=show npm start
VITE_PROFILE=dev

# WiFi the operator shares with guest phones (used for the mobile-app QR code)
VITE_WIFI_SSID=YourNetwork
VITE_WIFI_PW=YourPassword

# Port the Python core's API/WebSocket server listens on
VITE_BACKEND_PORT=8000

# Shared secret guarding destructive endpoints (delete/save/add/rename/etc.).
# The operator UI sends it as the X-Admin-Token header; Electron passes the same
# value to the Python core as L3D_ADMIN_TOKEN. Guest phones never have it, so
# they can tweak visuals but cannot mutate the database or delete presets.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, admin operations are refused (fail-closed).
VITE_ADMIN_TOKEN=YourSecretTokenHere
